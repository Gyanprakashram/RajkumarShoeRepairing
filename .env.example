# Import this file in Render with Environment > Add from .env.
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_POOLER_HOST/neondb?sslmode=require&channel_binding=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=SET_YOUR_NEON_PASSWORD
APP_JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
APP_ADMIN_PHONE=YOUR_ADMIN_PHONE
APP_ADMIN_PASSWORD=SET_A_STRONG_ADMIN_PASSWORD
APP_FRONTEND_URL=https://gyanprakashram.github.io/Rajkumar-shoe-repairing-fe/
APP_CORS_ORIGIN=https://gyanprakashram.github.io
